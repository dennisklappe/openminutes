      "avg_logprob": -0.189,
      "no_speech_prob": 0.084,
      "compression_ratio": 1.629
    },
    {
      "start": 162.1,
      "end": 162.66,
      "text": " Okay.",
      "avg_logprob": -0.189,
      "no_speech_prob": 0.084,
      "compression_ratio": 1.629
    },
    {
      "start": 164.3,
