# Required. Encrypts stored secrets. Generate one with: openssl rand -hex 32
OPENMINUTES_SECRET=

# Optional. Which release line to follow. Before 1.0 pin the minor (0.1, 0.2), from 1.0 the major (1).
# OPENMINUTES_TAG=0.1

# Optional. Timezone for minutes, as an IANA name. Settings, General overrides it.
# TZ=Europe/Amsterdam

# Optional. Port the web UI listens on.
# OPENMINUTES_PORT=3000

# Optional. Public base URL of this install, only needed behind a reverse proxy that changes host or scheme.
# It is used to build the OAuth redirect URIs, for example https://openminutes.example.com
# OPENMINUTES_PUBLIC_URL=

# Optional. Database password. Only used inside the compose network, but set your own if the port is ever exposed.
# POSTGRES_PASSWORD=

# Optional. Model for the local whisper service (profile "local").
# WHISPER_MODEL=small
# Optional. Whisper precision: int8 (default, about 1.4x faster at half the memory on a CPU, same word error rate), float32 or float16 (GPU).
# WHISPER_COMPUTE_TYPE=int8

# Optional. Let Cloudflare Access sign people in instead of an app password, see docs/configuration.md
# OPENMINUTES_AUTH=cloudflare-access
# OPENMINUTES_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
# OPENMINUTES_ACCESS_AUD=
# OPENMINUTES_ACCESS_EMAILS=
