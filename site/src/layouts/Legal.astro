---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={`${title} | OpenMinutes`} {description}>
  <div class="wide">
    <header class="page-head">
      <p class="crumb"><a href="/">OpenMinutes</a> / {title}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {updated && <p class="crumb">Last updated {updated}</p>}
    </header>
    <div class="prose readable legal">
      <slot />
    </div>
  </div>
</Base>

<style>
  .legal {
    padding-bottom: 2rem;
  }
</style>
