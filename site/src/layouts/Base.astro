---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { canonicalPath, siteUrl } from '../lib/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(canonicalPath(Astro.url.pathname), siteUrl).href;
const og = new URL('/brand/og.png', siteUrl).href;

const organization = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#org`,
  name: 'OpenMinutes',
  url: siteUrl,
  logo: new URL('/brand/icon-512.png', siteUrl).href,
};
const website = { '@type': 'WebSite', '@id': `${siteUrl}/#site`, name: 'OpenMinutes', url: siteUrl };
const graph = { '@context': 'https://schema.org', '@graph': [organization, website, ...jsonLd] };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var dark = matchMedia('(prefers-color-scheme: dark)');
        var pref = 'system';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') pref = saved;
        } catch (e) {}
        function effective() {
          return pref === 'system' ? (dark.matches ? 'dark' : 'light') : pref;
        }
        // Picture sources cannot read data-theme, so rewrite their media queries to match.
        function pictures() {
          var list = document.querySelectorAll('picture source[media*="prefers-color-scheme"], picture source[data-media]');
          for (var i = 0; i < list.length; i++) {
            var s = list[i];
            if (!s.hasAttribute('data-media')) s.setAttribute('data-media', s.getAttribute('media'));
            var orig = s.getAttribute('data-media');
            if (pref === 'system') s.setAttribute('media', orig);
            else if (orig.indexOf('prefers-color-scheme: ' + pref) < 0) s.setAttribute('media', 'not all');
            else s.setAttribute('media', orig.replace(/\s*(and\s*)?\(prefers-color-scheme:\s*\w+\)\s*(and\s*)?/, ' ').trim() || 'all');
          }
        }
        function apply() {
          if (pref === 'system') root.removeAttribute('data-theme');
          else root.setAttribute('data-theme', pref);
          root.setAttribute('data-pref', pref);
          var metas = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < metas.length; i++) {
            if (!metas[i].hasAttribute('data-media')) metas[i].setAttribute('data-media', metas[i].getAttribute('media'));
            var o = metas[i].getAttribute('data-media');
            metas[i].setAttribute('media', pref === 'system' || o.indexOf(effective()) > -1 ? o : 'not all');
          }
          pictures();
        }
        window.omTheme = {
          get: function () {
            return pref;
          },
          set: function (p) {
            pref = p;
            try {
              if (p === 'system') localStorage.removeItem('theme');
              else localStorage.setItem('theme', p);
            } catch (e) {}
            apply();
          },
        };
        if (pref !== 'system') root.setAttribute('data-theme', pref);
        root.setAttribute('data-pref', pref);
        document.addEventListener('DOMContentLoaded', apply);
      })();
    </script>
    <title>{title}</title>
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#f8f8f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0e10" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenMinutes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
