{
  "name": "openminutes",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Self-hosted meeting notetaker: joins Meet and Teams, records, transcribes and writes minutes.",
  "homepage": "https://openminut.es",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisklappe/openminutes.git"
  },
  "bugs": {
    "url": "https://github.com/dennisklappe/openminutes/issues"
  },
  "keywords": [
    "meeting-minutes",
    "transcription",
    "self-hosted",
    "google-meet",
    "microsoft-teams",
    "whisper",
    "meeting-bot"
  ],
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "notice": "node scripts/generate-notice.mjs",
    "docs:check": "node scripts/check-docs.mjs && node site/scripts/check-images.mjs --no-browser"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^30.1.3",
    "mermaid": "11",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "katex": ">=0.18.2",
      "esbuild@<0.25.0": ">=0.25.0"
    }
  }
}
