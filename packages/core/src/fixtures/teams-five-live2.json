  "truth": [
    {
      "speaker": "Alice Johnson",
      "startMs": 90860,
      "endMs": 97040,
      "text": "Good morning everyone. Today we are planning the launch of the new mobile app. The release date is the fourteenth of November."
    },
    {
      "speaker": "Bob Smith",
      "startMs": 98500,
      "endMs": 104680,
      "text": "Thanks Alice. The backend is almost ready. I still need to finish the payment integration, which should take three days."
    },
    {
      "speaker": "Carol Meyer",
      "startMs": 105640,
      "endMs": 111180,
      "text": "I have finished the new onboarding screens, and the design review is scheduled for Wednesday."
    },
    {
      "speaker": "Dave Okafor",
      "startMs": 111380,
      "endMs": 117580,
      "text": "On the infrastructure side, the staging servers are ready and I will run the load test on Thursday."
    },
    {
      "speaker": "Eve Lindqvist",
      "startMs": 117580,
      "endMs": 122800,
      "text": "I will write the release notes and update the help center before the launch."
    },
    {
      "speaker": "Alice Johnson",
      "startMs": 124320,
      "endMs": 130360,
      "text": "Great. Then I will prepare the marketing campaign and send the press release to the newsletter list by next Monday."
    },
    {
      "speaker": "Carol Meyer",
      "startMs": 131180,
      "endMs": 131480,
      "text": "Yes."
    },
    {
      "speaker": "Bob Smith",
      "startMs": 133320,
      "endMs": 138900,
      "text": "One risk is the app store review. Last time it took a week, so we should submit the build by the seventh of November."
    },
    {
      "speaker": "Dave Okafor",
      "startMs": 139700,
      "endMs": 139960,
      "text": "Right."
    },
    {
      "speaker": "Eve Lindqvist",
      "startMs": 141120,
      "endMs": 143000,
      "text": "Do we have a budget for the launch event?"
    },
    {
      "speaker": "Alice Johnson",
      "startMs": 143160,
      "endMs": 146160,
      "text": "Yes, I will confirm the budget of five thousand euros with finance."
    },
    {
      "speaker": "Carol Meyer",
      "startMs": 147580,
      "endMs": 152380,
      "text": "I can prepare the demo videos for the event if Dave shares the staging link."
    },
    {
      "speaker": "Dave Okafor",
      "startMs": 152480,
      "endMs": 156080,
      "text": "Sure, I will send the staging link to Carol this afternoon."
    },
    {
      "speaker": "Bob Smith",
      "startMs": 157580,
      "endMs": 161240,
      "text": "Understood. I will submit the build on the seventh and report back on Friday."
    },
    {
      "speaker": "Eve Lindqvist",
      "startMs": 161940,
      "endMs": 162400,
      "text": "Okay."
    },
    {
      "speaker": "Alice Johnson",
      "startMs": 163980,
      "endMs": 167540,
      "text": "Perfect. Eve, please send the notes to the whole team after the call."
    },
    {
      "speaker": "Eve Lindqvist",
      "startMs": 168060,
      "endMs": 170040,
      "text": "Will do. I will share the notes tomorrow morning."
    },
    {
      "speaker": "Dave Okafor",
      "startMs": 171320,
      "endMs": 171880,
      "text": "Agreed."
    },
    {
      "speaker": "Alice Johnson",
      "startMs": 173040,
      "endMs": 176060,
      "text": "Thanks everybody. Let us talk again next Tuesday."
    }
